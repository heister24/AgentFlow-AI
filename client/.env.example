# Firebase Web Config
VITE_FIREBASE_API_KEY=your_firebase_web_api_key

# Backend Gateway API Endpoint (e.g. https://api.agentflow.ai/api or http://<alb-or-ec2-ip>:8000/api)
VITE_BACKEND_URL=http://localhost:8000/api

# Razorpay Key ID (rzp_test_... for staging, rzp_live_... for production)
VITE_RAZORPAY_TEST_API_KEY=rzp_test_your_razorpay_key_id
