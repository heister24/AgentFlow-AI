PORT=8000
NODE_ENV=production

# Frontend Client URL(s) - Comma-separated if multiple (e.g. custom domain, cloudfront, localhost)
CLIENT_URL=http://localhost:5173,https://your-domain.com

# Microservices URLs (Use service names in Docker: http://auth-service:8001 or Cloud Map DNS)
AUTH_URL=http://localhost:8001
CHAT_URL=http://localhost:8002
AGENT_URL=http://localhost:8003
PAYMENT_URL=http://localhost:8004

# Redis URL (e.g. redis://redis:6379 or rediss://<elasticache-primary-endpoint>:6379)
REDIS_URL=redis://localhost:6379
