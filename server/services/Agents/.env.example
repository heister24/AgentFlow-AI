PORT=8003
NODE_ENV=production

# MongoDB Atlas connection URI
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/agent_db?retryWrites=true&w=majority

# Internal Service URLs
AUTH_URL=http://localhost:8001
CHAT_URL=http://localhost:8002
REDIS_URL=redis://localhost:6379

# AI Provider API Keys
GROQ_API_KEY=gsk_your_groq_api_key
GOOGLE_API_KEY=your_gemini_api_key
OPENROUTER_API_KEY=sk-or-your_openrouter_api_key
TAVILY_API_KEY=tvly-your_tavily_search_api_key

# AWS S3 Configuration for Document & Image Storage
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=agentflow-ai
# If using IAM Roles (ECS Task Role or EC2 Instance Profile), ACCESS_KEY and SECRET_KEY can be omitted:
AWS_ACCESS_KEY=your_aws_access_key
AWS_SECRET_KEY=your_aws_secret_key

# Qdrant Vector Database
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key
