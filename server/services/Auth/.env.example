PORT=8001
NODE_ENV=production

# MongoDB Atlas or DocumentDB connection URI
MONGO_URL=mongodb+srv://<user>:<password>@cluster.mongodb.net/auth_db?retryWrites=true&w=majority

# Redis URL for sessions
REDIS_URL=redis://localhost:6379

# Firebase Admin Credentials:
# Option A: Path to service account file
FIREBASE_CONFIG_PATH=./firebaseService.json
# Option B: Pass raw JSON string or base64 encoded JSON string directly (Recommended for AWS SSM / ECS Secrets)
# FIREBASE_SERVICE_ACCOUNT={"type": "service_account", "project_id": "...", ...}

# Cookie Configuration for Cross-Origin production deployments
COOKIE_SAMESITE=none
COOKIE_SECURE=true
# Optional: Set domain if frontend and backend share root domain (e.g. .agentflow.ai)
# COOKIE_DOMAIN=.agentflow.ai
