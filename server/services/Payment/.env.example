PORT=8004
NODE_ENV=production

# MongoDB Atlas or DocumentDB connection URI
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/payment_db?retryWrites=true&w=majority

# Auth Service Internal URL
AUTH_URL=http://localhost:8001

# Razorpay Production / Test Credentials
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
# Fallback / Test key support
RAZORPAY_TEST_API_KEY=rzp_test_your_test_key_id
RAZORPAY_TEST_SECRET_KEY=your_razorpay_test_secret
